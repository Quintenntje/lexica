# Copy to .env (the setup script does this for you) and adjust as needed.

# Service URLs (Docker Compose exposes these on localhost)
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lexica_chunks

# Models pulled by `npm run setup`
EMBEDDING_MODEL=nomic-embed-text
# Vector size of the embedding model (sizes the Qdrant collection)
EMBEDDING_DIMENSIONS=768
# Faster fallback on slow machines: qwen2.5:1.5b
CHAT_MODEL=qwen2.5:3b

# Minimum cosine similarity (-1..1) a retrieved passage needs to count as relevant.
# A top-3 keyword match also counts when it scores at least this minus 0.1. If no passage is
# relevant, Lexica answers "not found in the documents" without calling the model. Calibrated
# with `npm run eval` for nomic-embed-text (see docs/architecture.md, stage 5b).
MIN_RELEVANCE_SCORE=0.66

# API server port (the web dev server proxies /api to it)
API_PORT=8787
