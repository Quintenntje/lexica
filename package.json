{
  "name": "lexica",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "seed": "npm run seed -w @lexica/api",
    "eval": "npm run eval -w @lexica/api --",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @lexica/api\" \"npm run dev -w @lexica/web\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
